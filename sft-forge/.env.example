# Copy to .env and fill in. `sft-forge` reads .env from the CWD (or --env-file).
# The config file refers to these with ${VAR} interpolation.

# --- OpenAI-compatible endpoint (OpenAI, Groq, Together, Fireworks, vLLM, Ollama, ...) ---
OPENAI_API_KEY=sk-replace-me

# Optional overrides. Anything the endpoint accepts works; these are the common ones.
# OPENAI_BASE_URL=https://api.openai.com/v1
# SFT_FORGE_GENERATOR_MODEL=gpt-4o-mini
# SFT_FORGE_JUDGE_MODEL=gpt-4o-mini

# --- Cheaper local-ish alternatives (examples, not used by default) ---
# OPENAI_BASE_URL=http://localhost:11434/v1   # Ollama
# OPENAI_API_KEY=ollama
